#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run code quality metrics check
./scripts/check-metrics.sh || exit 1

# Get list of staged Rust files
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

# Run clippy on staged Rust files if any exist
if [ -n "$STAGED_RS_FILES" ]; then
    echo "🦀 Running clippy on staged Rust files..."
    cargo clippy --all-features -- -D warnings || {
        echo "❌ Clippy failed. Fix the issues above before committing."
        exit 1
    }
fi

# Get list of staged TypeScript/JavaScript files
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

# Run ESLint on staged TypeScript files if any exist
if [ -n "$STAGED_TS_FILES" ]; then
    echo "🔍 Running ESLint on staged TypeScript files..."
    npm run lint || {
        echo "❌ ESLint failed. Fix the issues above before committing."
        exit 1
    }
fi

echo "✅ All pre-commit checks passed!"
